<%- include('../partials/header', { pageHeading: 'Products Directory' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Product Catalog</h4>
        <p class="text-secondary small mb-0">Manage inventory items, SKUs, pricing, and stock thresholds</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/products/new" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-plus-circle me-1"></i> Add New Product
        </a>
        <a href="/reports/export/csv" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-download me-1"></i> Export Catalog
        </a>
    </div>
</div>

<!-- Search and Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form action="/products" method="GET" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, SKU or description" value="<%= search %>">
                </div>
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    <% categories.forEach(function(cat) { %>
                        <option value="<%= cat.id %>" <%= selectedCategoryId == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortBy" class="form-select form-select-sm">
                    <option value="created_at" <%= sortBy === 'created_at' ? 'selected' : '' %>>Sort by Registration Date</option>
                    <option value="name" <%= sortBy === 'name' ? 'selected' : '' %>>Sort by Product Name</option>
                    <option value="unit_price" <%= sortBy === 'unit_price' ? 'selected' : '' %>>Sort by Unit Price</option>
                    <option value="quantity" <%= sortBy === 'quantity' ? 'selected' : '' %>>Sort by Available Quantity</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-secondary w-100">Filter</button>
                <a href="/products" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Product Name</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Unit Price</th>
                    <th>Available Stock</th>
                    <th>Min Level</th>
                    <th>Status</th>
                    <th class="text-end" style="min-width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function(p) { %>
                        <tr>
                            <td class="text-muted small">#<%= p.id %></td>
                            <td>
                                <a href="/products/<%= p.id %>" class="fw-bold text-dark text-decoration-none hover-primary">
                                    <%= p.name %>
                                </a>
                                <% if (p.supplier_name) { %>
                                    <div class="small text-muted"><%= p.supplier_name %></div>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace"><%= p.sku %></span>
                            </td>
                            <td><%= p.category_name || 'Unassigned' %></td>
                            <td class="fw-medium">$<%= p.unit_price.toFixed(2) %></td>
                            <td>
                                <span class="fw-bold text-dark"><%= p.quantity %></span> Units
                            </td>
                            <td class="text-muted"><%= p.min_stock_level %></td>
                            <td>
                                <% if (p.quantity === 0) { %>
                                    <span class="badge bg-danger">Out of Stock</span>
                                <% } else if (p.quantity <= p.min_stock_level) { %>
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                <% } else { %>
                                    <span class="badge bg-success">In Stock</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="/products/<%= p.id %>" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/products/<%= p.id %>/edit" class="btn btn-outline-primary" title="Edit Product">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="/products/<%= p.id %>/delete" method="POST" class="d-inline" onsubmit="return confirmDelete('product');">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Product">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary"></i>
                            <div>No products found matching criteria</div>
                            <div class="mt-2">
                                <a href="/products/new" class="btn btn-sm btn-primary">Add First Product</a>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white border-top py-2 px-3 text-muted small d-flex justify-content-between align-items-center">
        <span>Showing <%= products.length %> items</span>
        <span class="text-muted">Digital Book Master Catalog</span>
    </div>
</div>

<%- include('../partials/footer') %>
