<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Digital Book | Enterprise Inventory' %></title>
    <!-- Google Fonts: Roboto -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Enterprise Stylesheet -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="app-wrapper">
    <%- include('sidebar') %>

    <div class="app-main">
        <!-- Top Application Header -->
        <header class="app-header">
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-outline-secondary d-lg-none me-2" id="sidebarToggle" aria-label="Toggle Navigation">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="header-breadcrumb">
                    <span class="text-secondary fw-medium">Digital Book</span>
                    <span class="mx-2 text-muted">/</span>
                    <span class="text-dark fw-bold"><%= typeof pageHeading !== 'undefined' ? pageHeading : 'Inventory Control System' %></span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a href="/stock/in" class="btn btn-sm btn-outline-success d-none d-md-inline-flex align-items-center">
                    <i class="bi bi-plus-circle me-1"></i> Stock In
                </a>
                <a href="/stock/out" class="btn btn-sm btn-outline-warning d-none d-md-inline-flex align-items-center">
                    <i class="bi bi-arrow-up-right me-1"></i> Stock Out
                </a>

                <!-- Top Right Login Logo and User Profile -->
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="dropdown">
                        <button class="btn btn-light border d-flex align-items-center gap-2 px-3 py-1 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5 text-primary"></i>
                            <span class="fw-medium text-dark"><%= user.full_name || user.username %></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="dropdown-header">
                                <div class="fw-bold"><%= user.full_name %></div>
                                <div class="text-muted small"><%= user.email %></div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger d-flex align-items-center" href="/logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                <% } else { %>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/login" class="btn btn-sm btn-primary d-flex align-items-center px-3" title="Access Administrator Portal">
                            <i class="bi bi-person-circle me-1 fs-6"></i>
                            <span>Admin Login</span>
                        </a>
                        <a href="/login/demo" class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center px-2" title="Direct One Click Demo Entry">
                            <span>Demo Access</span>
                        </a>
                    </div>
                <% } %>
            </div>
        </header>

        <!-- Main Body Content Container -->
        <main class="app-content p-4">
            <%- include('alerts') %>
