<%- include('../partials/header', { pageHeading: 'Executive Inventory Dashboard' }) %>

<!-- Key Performance Indicators -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card card-metric h-100 border-start border-4 border-primary">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Total Catalog Items</span>
                        <h2 class="fw-bold mt-2 mb-0 text-dark"><%= stats.totalProducts %></h2>
                    </div>
                    <div class="metric-icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top small text-muted">
                    <a href="/products" class="text-decoration-none text-primary fw-medium">View full catalog &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card card-metric h-100 border-start border-4 border-info">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Available Stock Units</span>
                        <h2 class="fw-bold mt-2 mb-0 text-dark"><%= stats.totalStock.toLocaleString() %></h2>
                    </div>
                    <div class="metric-icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-layers fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top small text-muted">
                    <span>Physical units across all locations</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card card-metric h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Low Stock Watchlist</span>
                        <h2 class="fw-bold mt-2 mb-0 text-warning"><%= stats.lowStock %></h2>
                    </div>
                    <div class="metric-icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top small text-muted">
                    <a href="/stock/low" class="text-decoration-none text-warning fw-medium">Inspect alert records &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card card-metric h-100 border-start border-4 border-danger">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-bold text-uppercase">Out of Stock Items</span>
                        <h2 class="fw-bold mt-2 mb-0 text-danger"><%= stats.outOfStock %></h2>
                    </div>
                    <div class="metric-icon-box bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-x-octagon fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top small text-muted">
                    <span class="text-danger fw-medium">Immediate replenishment needed</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Valuation and Quick Actions Row -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 bg-navy text-white rounded">
                <div class="d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 text-uppercase small fw-bold tracking-wide">Total Estimated Valuation</span>
                        <h1 class="display-6 fw-bold mb-1 mt-2 text-white">$<%= stats.totalValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h1>
                        <p class="text-white-50 small mb-0">Aggregated inventory valuation based on current quantity and unit price.</p>
                    </div>
                    <div class="mt-3 mt-md-0 d-flex gap-2">
                        <a href="/reports" class="btn btn-light px-3 fw-medium">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> View Detailed Report
                        </a>
                        <a href="/reports/export/csv" class="btn btn-outline-light px-3">
                            <i class="bi bi-download me-1"></i> Download CSV
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark">Quick Inventory Operations</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center gap-2">
                <a href="/stock/in" class="btn btn-outline-success d-flex align-items-center justify-content-between p-2">
                    <span class="d-flex align-items-center"><i class="bi bi-box-arrow-in-down me-2 fs-5"></i> Receive Incoming Stock In</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a href="/stock/out" class="btn btn-outline-warning d-flex align-items-center justify-content-between p-2">
                    <span class="d-flex align-items-center"><i class="bi bi-box-arrow-up-right me-2 fs-5"></i> Dispatch Outgoing Stock Out</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
                <a href="/products/new" class="btn btn-outline-primary d-flex align-items-center justify-content-between p-2">
                    <span class="d-flex align-items-center"><i class="bi bi-plus-square me-2 fs-5"></i> Register New Product Item</span>
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Analytics Charts -->
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">Stock Units Distribution by Category</h6>
                <span class="badge bg-light text-secondary border">Realtime</span>
            </div>
            <div class="card-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="categoryDistributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">Cumulative Stock Movements</h6>
                <span class="badge bg-light text-secondary border">Overall</span>
            </div>
            <div class="card-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="stockMovementsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recently Registered Products and Recent Stock Transactions -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">Recently Registered Products</h6>
                <a href="/products" class="small text-decoration-none fw-medium text-primary">All Products</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>SKU</th>
                            <th>Unit Price</th>
                            <th>Stock</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentProducts && recentProducts.length > 0) { %>
                            <% recentProducts.forEach(function(prod) { %>
                                <tr>
                                    <td>
                                        <div class="fw-medium text-dark"><%= prod.name %></div>
                                        <div class="text-muted small"><%= prod.category_name || 'Unassigned' %></div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border font-monospace"><%= prod.sku %></span></td>
                                    <td>$<%= prod.unit_price.toFixed(2) %></td>
                                    <td>
                                        <% if (prod.quantity === 0) { %>
                                            <span class="badge bg-danger">Out of Stock</span>
                                        <% } else if (prod.quantity <= prod.min_stock_level) { %>
                                            <span class="badge bg-warning text-dark">Low Stock (<%= prod.quantity %>)</span>
                                        <% } else { %>
                                            <span class="badge bg-success"><%= prod.quantity %> Units</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/products/<%= prod.id %>" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Inspect">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No registered products recorded</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">Recent Stock Transactions</h6>
                <a href="/stock/history" class="small text-decoration-none fw-medium text-primary">Full History</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Ref Code</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentTransactions && recentTransactions.length > 0) { %>
                            <% recentTransactions.forEach(function(tx) { %>
                                <tr>
                                    <td>
                                        <% if (tx.transaction_type === 'STOCK_IN') { %>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Stock In</span>
                                        <% } else { %>
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">Stock Out</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark"><%= tx.product_name || 'Item #' + tx.product_id %></div>
                                    </td>
                                    <td class="fw-bold <%= tx.transaction_type === 'STOCK_IN' ? 'text-success' : 'text-danger' %>">
                                        <%= tx.transaction_type === 'STOCK_IN' ? '+' : '' %><%= tx.quantity %>
                                    </td>
                                    <td><span class="font-monospace small text-muted"><%= tx.reference_number || 'N/A' %></span></td>
                                    <td class="small text-muted"><%= tx.transaction_date ? tx.transaction_date.toString().substring(0, 10).replace(/-/g, '/') : '' %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No stock movement recorded</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    fetch('/api/dashboard/charts')
        .then(function(res) { return res.json(); })
        .then(function(data) {
            // Category Distribution Chart
            const catCtx = document.getElementById('categoryDistributionChart');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'bar',
                    data: {
                        labels: data.categoryLabels,
                        datasets: [{
                            label: 'Available Stock Units',
                            data: data.categoryQuantities,
                            backgroundColor: '#2563eb',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#f1f5f9' }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // Stock Movements Chart
            const movCtx = document.getElementById('stockMovementsChart');
            if (movCtx) {
                new Chart(movCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Stock In Units', 'Stock Out Units'],
                        datasets: [{
                            data: [data.movements.stockIn, data.movements.stockOut],
                            backgroundColor: ['#16a34a', '#d97706'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }
        })
        .catch(function(err) {
            console.error('Error rendering dashboard charts:', err);
        });
});
</script>

<%- include('../partials/footer') %>
