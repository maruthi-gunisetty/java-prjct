<%- include('../partials/header', { pageHeading: 'Low Stock and Out of Stock Alerts' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Low Stock Watchlist</h4>
        <p class="text-secondary small mb-0">Automated monitoring of inventory items breaching safety thresholds</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/stock/in" class="btn btn-success d-flex align-items-center">
            <i class="bi bi-box-arrow-in-down me-1"></i> Receive Replenishment Stock
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Product Item</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Current Stock</th>
                    <th>Min Threshold</th>
                    <th>Deficit</th>
                    <th>Status</th>
                    <th class="text-end" style="min-width: 140px;">Action</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function(p) { %>
                        <tr>
                            <td class="text-muted small">#<%= p.id %></td>
                            <td>
                                <a href="/products/<%= p.id %>" class="fw-bold text-dark text-decoration-none hover-primary">
                                    <%= p.name %>
                                </a>
                                <% if (p.supplier_name) { %>
                                    <div class="small text-muted"><%= p.supplier_name %></div>
                                <% } %>
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace"><%= p.sku %></span></td>
                            <td><%= p.category_name || 'Unassigned' %></td>
                            <td>
                                <span class="fw-bold <%= p.quantity === 0 ? 'text-danger' : 'text-warning' %>"><%= p.quantity %></span> Units
                            </td>
                            <td class="text-muted"><%= p.min_stock_level %> Units</td>
                            <td>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                    Short by <%= Math.max(0, p.min_stock_level - p.quantity) %> Units
                                </span>
                            </td>
                            <td>
                                <% if (p.quantity === 0) { %>
                                    <span class="badge bg-danger">Out of Stock</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <a href="/stock/in?productId=<%= p.id %>" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-plus-circle me-1"></i> Restock
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                            <div class="fw-medium text-dark">All products are healthy and within safety thresholds!</div>
                            <div class="small text-muted mt-1">No items currently requiring replenishment</div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
