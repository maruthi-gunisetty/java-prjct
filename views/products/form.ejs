<%- include('../partials/header', { pageHeading: isEdit ? 'Modify Product Information' : 'Product Registration' }) %>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><%= isEdit ? 'Edit Product Item' : 'Register New Product' %></h4>
                <p class="text-secondary small mb-0">Complete the details below to record product metadata and stock rules</p>
            </div>
            <a href="/products" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Catalog
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form action="<%= isEdit ? '/products/' + product.id + '/edit' : '/products' %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="name" class="form-label fw-medium text-dark">Product Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" value="<%= product.name || '' %>" required placeholder="e.g. High Speed Managed Switch">
                        </div>

                        <div class="col-md-4">
                            <label for="sku" class="form-label fw-medium text-dark">Stock Keeping Unit (SKU) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" id="sku" name="sku" value="<%= product.sku || '' %>" required placeholder="e.g. SKU2048">
                            <div class="form-text">Must be globally unique</div>
                        </div>

                        <div class="col-md-6">
                            <label for="category_id" class="form-label fw-medium text-dark">Product Category <span class="text-danger">*</span></label>
                            <select class="form-select" id="category_id" name="category_id" required>
                                <option value="" disabled <%= !product.category_id ? 'selected' : '' %>>Select a Category</option>
                                <% categories.forEach(function(cat) { %>
                                    <option value="<%= cat.id %>" <%= product.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="supplier_id" class="form-label fw-medium text-dark">Assigned Supplier</label>
                            <select class="form-select" id="supplier_id" name="supplier_id">
                                <option value="">None / Direct Procurement</option>
                                <% suppliers.forEach(function(sup) { %>
                                    <option value="<%= sup.id %>" <%= product.supplier_id == sup.id ? 'selected' : '' %>><%= sup.name %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label for="unit_price" class="form-label fw-medium text-dark">Unit Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" min="0" class="form-control" id="unit_price" name="unit_price" value="<%= product.unit_price !== undefined ? product.unit_price : '' %>" required placeholder="0.00">
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label for="quantity" class="form-label fw-medium text-dark"><%= isEdit ? 'Available Stock Quantity' : 'Initial Stock Quantity' %> <span class="text-danger">*</span></label>
                            <input type="number" min="0" class="form-control" id="quantity" name="quantity" value="<%= product.quantity !== undefined ? product.quantity : '0' %>" required>
                            <div class="form-text"><%= isEdit ? 'Direct inventory override' : 'Opening balance for inventory' %></div>
                        </div>

                        <div class="col-md-4">
                            <label for="min_stock_level" class="form-label fw-medium text-dark">Minimum Stock Alert Threshold <span class="text-danger">*</span></label>
                            <input type="number" min="0" class="form-control" id="min_stock_level" name="min_stock_level" value="<%= product.min_stock_level !== undefined ? product.min_stock_level : '10' %>" required>
                            <div class="form-text">Triggers low stock alert when breached</div>
                        </div>

                        <div class="col-12">
                            <label for="description" class="form-label fw-medium text-dark">Item Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Enter optional specifications, technical notes, or storage conditions"><%= product.description || '' %></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="/products" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i> <%= isEdit ? 'Update Product Item' : 'Register Product' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
