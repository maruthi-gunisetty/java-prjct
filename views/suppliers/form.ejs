<%- include('../partials/header', { pageHeading: isEdit ? 'Edit Supplier' : 'Register Supplier' }) %>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><%= isEdit ? 'Edit Supplier Information' : 'Register New Supplier' %></h4>
                <p class="text-secondary small mb-0">Record vendor contact details and distribution profile</p>
            </div>
            <a href="/suppliers" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Suppliers
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form action="<%= isEdit ? '/suppliers/' + supplier.id + '/edit' : '/suppliers' %>" method="POST">
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="name" class="form-label fw-medium text-dark">Supplier Organization Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="name" name="name" value="<%= supplier.name || '' %>" required placeholder="e.g. Apex Industrial Supplies">
                        </div>

                        <div class="col-md-6">
                            <label for="contact_person" class="form-label fw-medium text-dark">Contact Representative</label>
                            <input type="text" class="form-control" id="contact_person" name="contact_person" value="<%= supplier.contact_person || '' %>" placeholder="e.g. Robert Vance">
                        </div>

                        <div class="col-md-6">
                            <label for="phone" class="form-label fw-medium text-dark">Phone Number</label>
                            <input type="text" class="form-control" id="phone" name="phone" value="<%= supplier.phone || '' %>" placeholder="e.g. +1 555 0192">
                        </div>

                        <div class="col-12">
                            <label for="email" class="form-label fw-medium text-dark">Email Address</label>
                            <input type="email" class="form-control" id="email" name="email" value="<%= supplier.email || '' %>" placeholder="e.g. contact@apexsupplies.com">
                        </div>

                        <div class="col-12">
                            <label for="address" class="form-label fw-medium text-dark">Physical Address / Headquarters</label>
                            <textarea class="form-control" id="address" name="address" rows="3" placeholder="Street, city, postal code, and country"><%= supplier.address || '' %></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a href="/suppliers" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i> <%= isEdit ? 'Update Supplier' : 'Register Supplier' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
