<%- include('../partials/header', { pageHeading: 'Stock Transaction Audit History' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Transaction Audit Log</h4>
        <p class="text-secondary small mb-0">Complete historical record of incoming and outgoing inventory movements</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/stock/in" class="btn btn-outline-success btn-sm d-flex align-items-center">
            <i class="bi bi-box-arrow-in-down me-1"></i> Stock In
        </a>
        <a href="/stock/out" class="btn btn-outline-warning btn-sm d-flex align-items-center">
            <i class="bi bi-box-arrow-up-right me-1"></i> Stock Out
        </a>
        <button onclick="triggerPrintReport()" class="btn btn-outline-secondary btn-sm d-flex align-items-center">
            <i class="bi bi-printer me-1"></i> Print Log
        </button>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form action="/stock/history" method="GET" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Movement Types</option>
                    <option value="STOCK_IN" <%= selectedType === 'STOCK_IN' ? 'selected' : '' %>>Stock In Only</option>
                    <option value="STOCK_OUT" <%= selectedType === 'STOCK_OUT' ? 'selected' : '' %>>Stock Out Only</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="productId" class="form-select form-select-sm">
                    <option value="">All Catalog Products</option>
                    <% products.forEach(function(p) { %>
                        <option value="<%= p.id %>" <%= selectedProductId == p.id ? 'selected' : '' %>><%= p.name %> (SKU: <%= p.sku %>)</option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-secondary w-100">Filter Log</button>
                <a href="/stock/history" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Transactions Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Type</th>
                    <th>Product Item</th>
                    <th>Units</th>
                    <th>Unit Cost</th>
                    <th>Reference</th>
                    <th>Supplier / Recipient</th>
                    <th>Notes</th>
                    <th>Date Recorded</th>
                </tr>
            </thead>
            <tbody>
                <% if (transactions && transactions.length > 0) { %>
                    <% transactions.forEach(function(tx) { %>
                        <tr>
                            <td class="text-muted small">#<%= tx.id %></td>
                            <td>
                                <% if (tx.transaction_type === 'STOCK_IN') { %>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Stock In</span>
                                <% } else { %>
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">Stock Out</span>
                                <% } %>
                            </td>
                            <td>
                                <a href="/products/<%= tx.product_id %>" class="fw-bold text-dark text-decoration-none hover-primary">
                                    <%= tx.product_name || 'Item #' + tx.product_id %>
                                </a>
                                <% if (tx.product_sku) { %>
                                    <span class="font-monospace text-muted small ms-1">(<%= tx.product_sku %>)</span>
                                <% } %>
                            </td>
                            <td class="fw-bold <%= tx.transaction_type === 'STOCK_IN' ? 'text-success' : 'text-danger' %>">
                                <%= tx.transaction_type === 'STOCK_IN' ? '+' : '-' %><%= tx.quantity %>
                            </td>
                            <td>$<%= (tx.unit_price || 0).toFixed(2) %></td>
                            <td><span class="font-monospace small"><%= tx.reference_number || 'N/A' %></span></td>
                            <td><%= tx.supplier_name || 'N/A' %></td>
                            <td class="small text-muted"><%= tx.notes || 'None' %></td>
                            <td class="small text-muted"><%= tx.transaction_date ? tx.transaction_date.toString().substring(0, 10).replace(/-/g, '/') : '' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <div>No transaction logs matching selected criteria</div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white border-top py-2 px-3 text-muted small d-flex justify-content-between align-items-center">
        <span>Showing <%= transactions.length %> transaction records</span>
        <span class="text-muted">Digital Book Audit Engine</span>
    </div>
</div>

<%- include('../partials/footer') %>
