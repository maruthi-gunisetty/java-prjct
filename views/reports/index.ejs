<%- include('../partials/header', { pageHeading: 'Inventory Valuation and Stock Reports' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Inventory Valuation and Audit Report</h4>
        <p class="text-secondary small mb-0">Financial valuation, stock status distribution, and enterprise inventory metrics</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/reports/export/csv?status=<%= selectedStatus %>&categoryId=<%= selectedCategoryId %>" class="btn btn-outline-primary d-flex align-items-center">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Download CSV File
        </a>
        <button onclick="triggerPrintReport()" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Summary Valuation Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-light">
            <span class="text-secondary small fw-bold text-uppercase">Items Evaluated</span>
            <div class="h3 fw-bold mt-1 mb-0 text-dark"><%= totalItems %> Products</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-light">
            <span class="text-secondary small fw-bold text-uppercase">Total Quantity on Hand</span>
            <div class="h3 fw-bold mt-1 mb-0 text-primary"><%= totalQuantity.toLocaleString() %> Units</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-navy text-white">
            <span class="text-white-50 small fw-bold text-uppercase">Aggregated Inventory Value</span>
            <div class="h3 fw-bold mt-1 mb-0 text-white">$<%= totalValuation.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> USD</div>
        </div>
    </div>
</div>

<!-- Report Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form action="/reports" method="GET" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Stock Statuses</option>
                    <option value="IN_STOCK" <%= selectedStatus === 'IN_STOCK' ? 'selected' : '' %>>In Stock Items Only</option>
                    <option value="LOW_STOCK" <%= selectedStatus === 'LOW_STOCK' ? 'selected' : '' %>>Low Stock Items Only</option>
                    <option value="OUT_OF_STOCK" <%= selectedStatus === 'OUT_OF_STOCK' ? 'selected' : '' %>>Out of Stock Items Only</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">All Product Categories</option>
                    <% categories.forEach(function(cat) { %>
                        <option value="<%= cat.id %>" <%= selectedCategoryId == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-secondary w-100">Apply Filter</button>
                <a href="/reports" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Report Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Product Name</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th>Total Valuation</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function(p) { %>
                        <tr>
                            <td class="text-muted small">#<%= p.id %></td>
                            <td>
                                <div class="fw-bold text-dark"><%= p.name %></div>
                                <% if (p.supplier_name) { %>
                                    <div class="small text-muted"><%= p.supplier_name %></div>
                                <% } %>
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace"><%= p.sku %></span></td>
                            <td><%= p.category_name || 'Unassigned' %></td>
                            <td>$<%= p.unit_price.toFixed(2) %></td>
                            <td class="fw-bold"><%= p.quantity %> Units</td>
                            <td class="fw-bold text-primary">$<%= (p.quantity * p.unit_price).toFixed(2) %></td>
                            <td>
                                <% if (p.quantity === 0) { %>
                                    <span class="badge bg-danger">Out of Stock</span>
                                <% } else if (p.quantity <= p.min_stock_level) { %>
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                <% } else { %>
                                    <span class="badge bg-success">In Stock</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No inventory records matching selected filters</td>
                    </tr>
                <% } %>
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end">Summary Totals:</td>
                    <td><%= totalQuantity.toLocaleString() %> Units</td>
                    <td class="text-primary">$<%= totalValuation.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
