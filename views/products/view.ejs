<%- include('../partials/header', { pageHeading: 'Product Specification' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0 text-dark"><%= product.name %></h4>
            <span class="badge bg-light text-dark border font-monospace"><%= product.sku %></span>
            <% if (product.quantity === 0) { %>
                <span class="badge bg-danger">Out of Stock</span>
            <% } else if (product.quantity <= product.min_stock_level) { %>
                <span class="badge bg-warning text-dark">Low Stock Alert</span>
            <% } else { %>
                <span class="badge bg-success">In Stock</span>
            <% } %>
        </div>
        <p class="text-secondary small mt-1 mb-0">Registered under <%= product.category_name || 'Unassigned Category' %></p>
    </div>

    <div class="d-flex gap-2">
        <a href="/stock/in?productId=<%= product.id %>" class="btn btn-outline-success btn-sm d-flex align-items-center">
            <i class="bi bi-box-arrow-in-down me-1"></i> Stock In
        </a>
        <a href="/stock/out?productId=<%= product.id %>" class="btn btn-outline-warning btn-sm d-flex align-items-center">
            <i class="bi bi-box-arrow-up-right me-1"></i> Stock Out
        </a>
        <a href="/products/<%= product.id %>/edit" class="btn btn-outline-primary btn-sm d-flex align-items-center">
            <i class="bi bi-pencil me-1"></i> Edit Product
        </a>
        <form action="/products/<%= product.id %>/delete" method="POST" class="d-inline" onsubmit="return confirmDelete('product');">
            <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
        </form>
        <a href="/products" class="btn btn-secondary btn-sm d-flex align-items-center">
            <i class="bi bi-arrow-left me-1"></i> Catalog
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark">Product Specification & Inventory Metrics</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Available Quantity</span>
                            <span class="h3 fw-bold text-dark"><%= product.quantity %></span>
                            <span class="text-muted ms-1">Units</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Unit Selling Price</span>
                            <span class="h3 fw-bold text-dark">$<%= product.unit_price.toFixed(2) %></span>
                            <span class="text-muted ms-1">USD</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Total Stock Value</span>
                            <span class="h3 fw-bold text-primary">$<%= (product.quantity * product.unit_price).toFixed(2) %></span>
                            <span class="text-muted ms-1">USD</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Alert Reorder Level</span>
                            <span class="h3 fw-bold text-warning"><%= product.min_stock_level %></span>
                            <span class="text-muted ms-1">Units</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <h6 class="fw-bold text-dark mb-2">Description</h6>
                    <p class="text-secondary mb-0"><%= product.description || 'No detailed specifications supplied for this inventory item.' %></p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-dark">Association Details</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <span class="text-muted small d-block">Category</span>
                    <span class="fw-medium text-dark"><%= product.category_name || 'Unassigned' %></span>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">Designated Supplier</span>
                    <span class="fw-medium text-dark"><%= product.supplier_name || 'Direct Procurement' %></span>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">First Registered</span>
                    <span class="fw-medium text-dark"><%= product.created_at ? product.created_at.toString().substring(0, 10).replace(/-/g, '/') : 'N/A' %></span>
                </div>
                <div class="mb-3">
                    <span class="text-muted small d-block">System Record ID</span>
                    <span class="font-monospace small text-dark">#<%= product.id %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stock Transaction History for This Product -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">Transaction Log for this Product</h6>
        <span class="badge bg-light text-secondary border">Recent Movement</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Quantity</th>
                    <th>Unit Cost</th>
                    <th>Reference</th>
                    <th>Supplier / Partner</th>
                    <th>Notes</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <% if (transactions && transactions.length > 0) { %>
                    <% transactions.forEach(function(tx) { %>
                        <tr>
                            <td>
                                <% if (tx.transaction_type === 'STOCK_IN') { %>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Stock In</span>
                                <% } else { %>
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">Stock Out</span>
                                <% } %>
                            </td>
                            <td class="fw-bold <%= tx.transaction_type === 'STOCK_IN' ? 'text-success' : 'text-danger' %>">
                                <%= tx.transaction_type === 'STOCK_IN' ? '+' : '' %><%= tx.quantity %>
                            </td>
                            <td>$<%= (tx.unit_price || product.unit_price).toFixed(2) %></td>
                            <td><span class="font-monospace small"><%= tx.reference_number || 'N/A' %></span></td>
                            <td><%= tx.supplier_name || 'N/A' %></td>
                            <td class="small text-muted"><%= tx.notes || 'None' %></td>
                            <td class="small text-muted"><%= tx.transaction_date ? tx.transaction_date.toString().substring(0, 10).replace(/-/g, '/') : '' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No transaction records logged for this item</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
